# Sanity. Hodnoty nájdete na https://www.sanity.io/manage po vytvorení projektu.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Ľubovoľný náhodný reťazec. Rovnakú hodnotu zadajte aj do webhooku v Sanity.
SANITY_REVALIDATE_SECRET=

# Len pre `npm run sanity:seed`. Token s právom Editor. Do Vercelu ho nepridávajte.
SANITY_API_WRITE_TOKEN=
